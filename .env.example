# Copy this file to `.env` next to pyproject.toml — aigate loads it at startup.
# Real environment variables always win over the file (so `$env:X = ...` in a
# shell beats what is written here). `.env` is gitignored; never commit keys.

# --- gateway ---
AIGATE_LOG_LEVEL=INFO
# Comma separated bootstrap keys. Empty = auth disabled (dev mode) until a key
# is created through /admin/keys.
AIGATE_API_KEYS=
# Timeout for one upstream call, seconds.
AIGATE_REQUEST_TIMEOUT_S=60
# Artificial delay between mock stream chunks, seconds (demo only).
AIGATE_MOCK_DELAY_S=0

# --- metering (M3) ---
# SQLite by default: zero setup, schema created on boot.
AIGATE_DATABASE_URL=sqlite+aiosqlite:///./aigate.db
# Postgres (docker compose --profile full up) instead:
# AIGATE_DATABASE_URL=postgresql+asyncpg://aigate:aigate@localhost:5432/aigate
# Enables /admin/*. Empty means the admin API answers 503 (fail closed).
AIGATE_ADMIN_TOKEN=
# How often buffered metering rows are written; 0.5s is a good default.
AIGATE_USAGE_FLUSH_INTERVAL_S=0.5
AIGATE_USAGE_QUEUE_SIZE=2000

# --- upstream providers (any subset; mock is always available) ---
# DeepSeek: https://platform.deepseek.com/api_keys (needs a balance, ~a few cents
# for a whole eval run). Setting any one of these means it becomes the "default"
# route once the process restarts.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# --- cache (M4) ---
AIGATE_CACHE_ENABLED=true
AIGATE_CACHE_TTL_S=3600
AIGATE_CACHE_MAX_ENTRIES=2048
# Semantic layer needs a real embedder; until one is wired in, leave this alone.
AIGATE_SEMANTIC_CACHE=false
AIGATE_SEMANTIC_THRESHOLD=0.92
# AIGATE_REDIS_URL=redis://localhost:6379/0

# Optional: replace the default route table entirely. JSON, alias -> [provider:model, ...]
# AIGATE_ROUTES={"default": ["deepseek:deepseek-chat"], "cheap": ["qwen:qwen-turbo"], "mock": ["mock:mock-echo"]}
