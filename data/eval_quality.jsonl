{"id": "struct-1", "input": "Return a compact JSON object with status set to \"ok\" and count set to 3. Output JSON only.", "grading": {"kind": "regex", "pattern": "(?si)(?=.*\"status\"\\s*:\\s*\"ok\")(?=.*\"count\"\\s*:\\s*3)"}, "tags": ["structured"]}
{"id": "struct-2", "input": "Return a JSON array with exactly three lowercase strings: red, green, blue. Output JSON only.", "grading": {"kind": "regex", "pattern": "(?si)(?=.*\"red\")(?=.*\"green\")(?=.*\"blue\")"}, "tags": ["structured"]}
{"id": "struct-3", "input": "Reply with exactly the word READY and nothing else.", "expected": "READY", "grading": "exact", "tags": ["structured"]}
{"id": "struct-4", "input": "Write the SQL statement that selects every column from the users table where age is greater than 18. SQL only.", "grading": {"kind": "regex", "pattern": "(?si)select\\s+\\*\\s+from\\s+users\\s+where\\s+age\\s*>\\s*18"}, "tags": ["structured"]}
{"id": "struct-5", "input": "Return the JSON object with the single key ok whose value is the boolean true. Output JSON only.", "grading": {"kind": "regex", "pattern": "(?si)\\{\\s*\"ok\"\\s*:\\s*true\\s*\\}"}, "tags": ["structured"]}
{"id": "struct-6", "input": "Output only a CSV header row with the three columns name, age and city in that order.", "grading": {"kind": "regex", "pattern": "(?i)name\\s*,\\s*age\\s*,\\s*city"}, "tags": ["structured"]}
{"id": "struct-7", "input": "Print the Python expression that sums the list [1, 2, 3] with the built-in sum function. Expression only.", "grading": {"kind": "regex", "pattern": "(?si)sum\\(\\s*\\[\\s*1\\s*,\\s*2\\s*,\\s*3\\s*\\]\\s*\\)"}, "tags": ["structured"]}
{"id": "struct-8", "input": "Return the nested JSON object where key user maps to an object with id equal to 7. Output JSON only.", "grading": {"kind": "regex", "pattern": "(?si)\"user\"\\s*:\\s*\\{\\s*\"id\"\\s*:\\s*7\\s*\\}"}, "tags": ["structured"]}
{"id": "instr-1", "input": "Reply with exactly the two words good morning and nothing else.", "expected": "good morning", "grading": "exact", "tags": ["instruction"]}
{"id": "instr-2", "input": "What is the capital of France? Answer with at most three words.", "expected": "Paris", "grading": {"kind": "regex", "pattern": "(?i)^\\s*paris[.!]?\\s*$"}, "tags": ["instruction"]}
{"id": "instr-3", "input": "How many letters are in the word strawberry? Reply with the digits only.", "expected": "10", "grading": "numeric", "tags": ["instruction"]}
